{
  "name": "super-mario-kart-sfml.js",
  "version": "1.0.2",
  "private": true,
  "description": "A file-for-file TypeScript port of Süper Mario Kart using sfml.js.",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:release": "npm run typecheck && node tools/build-release.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.cjs",
    "prepackage": "npm run build:release",
    "package": "node tools/package.cjs",
    "start": "npm run build && node dist/main.js",
    "dev": "npm run start"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "sfml.js": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "rcedit": "5.0.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "appdmg": "0.6.6"
  }
}
