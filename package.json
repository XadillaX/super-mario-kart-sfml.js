{
  "name": "super-mario-kart-sfml.js",
  "version": "1.0.0",
  "private": true,
  "description": "A file-for-file TypeScript port of Süper Mario Kart using sfml.js.",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && node dist/main.js",
    "dev": "npm run start"
  },
  "engines": {
    "node": ">=20.5.0"
  },
  "dependencies": {
    "sfml.js": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "typescript": "7.0.2"
  }
}
